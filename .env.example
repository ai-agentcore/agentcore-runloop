# Pure Sandbox service. No model, Agent SDK identity, MCP or Skill configuration required.
AGENTCORE_HOST=127.0.0.1
AGENTCORE_PORT=8080
# Required: independent random token, at least 32 characters. Never commit the real value.
AGENTCORE_RUNLOOP_API_TOKEN=
# Trusted deployment root; must be writable by the container's coder user.
AGENTCORE_WORKDIR=/workspace
# Fixed by deployment, never supplied by request. Storage: <root>/<uid>/<session>.
AGENTCORE_SANDBOX_UID=
AGENTCORE_SANDBOX_SESSION_ID=
AGENTCORE_SANDBOX_CLI=codex
