# Required AgentCore resources
AGENTCORE_MODEL_CONNECTION=replace-with-your-model-connection
AGENTCORE_MODEL_NAME=qwen3.8-max
# Model policy
AGENTCORE_MODEL_ENABLE_THINKING=false
# AgentCore credential name containing a Bailian API key. Set to 0 to disable.
IMAGE_ABLE=DASHBOARD_API_KEY
# AGENTCORE_IMAGE_VISION_MODEL=qwen-vl-max
# AGENTCORE_IMAGE_GENERATION_MODEL=qwen-image-plus

# Optional managed resources
AGENTCORE_MCP_SERVERS=
# Request-path soft wait for MCP discovery. 0 returns immediately with cached/ready tools; discovery continues in the background.
AGENTCORE_MCP_INITIAL_WAIT_MS=300
# Per-MCP resolve/connect/listTools hard deadline. Timeout aborts discovery; failed MCPs retry in the background.
AGENTCORE_MCP_DISCOVERY_TIMEOUT_MS=10000
# Optional per-resource overrides in name=milliseconds form. Names must also appear in AGENTCORE_MCP_SERVERS.
# AGENTCORE_MCP_DISCOVERY_TIMEOUTS=fast-mcp=5000,slow-mcp=60000
# Example: code-review@v1.2.0,report
AGENTCORE_SKILLS=
# Persistent SDK Skill packages and Skill-local dependencies. The image default
# uses the AgenticFS mount below; local development may choose another directory.
# AGENTCORE_SKILL_WORKSPACE_DIR=/mnt/agenticfs/shared/.agentcore/skills

# Deployment instructions
AGENTCORE_SYSTEM_PROMPT="你是研发助手，请用中文回答，并在修改代码后验证结果。"

# Agent execution
AGENTCORE_EXECUTION=local
# Codex uses the fixed agentcore MCP namespace (e.g. mcp__agentcore__bash).
# Codex MCP tools report start before execution and result after completion over SSE/AG-UI.
# Assistant candidates stream as AG-UI thinking activity; only the completed final candidate is promoted to text with the same messageId.
# No extra flag is needed; the adapter suppresses duplicate CLI tool events.
# Only Codex is supported.
AGENTCORE_AGENT_CLI=codex
AGENTCORE_RUN_TIMEOUT_MS=21600000
# Per-attachment download timeout (30 minutes by default).
AGENTCORE_ATTACHMENT_DOWNLOAD_TIMEOUT_MS=1800000
# Local requires Codex OS sandbox: user-root read/write, bound Skills read-only,
# command network disabled. Failed sandbox preflight stops the run.
# Local work root defaults to /tmp/agentcore-user-work, with or without artifacts.
# Sandbox mode always executes remotely; timeout never falls back to this root.
# Codex helper home must be outside OS temp and user-writable business roots.
# AGENTCORE_CODEX_HOME_ROOT=/app/agentcore-runloop/.agentcore-codex
# AGENTCORE_WORKDIR=/your/agenticfs/work-root
# AGENTCORE_ARTIFACT_ROOT=/your/oss/artifact-root

# Alibaba Cloud Agent Sandbox execution (used only when AGENTCORE_EXECUTION=sandbox).
# Direct Key injection takes precedence over AgentCore credential lookup. Inject
# it as a deployment secret; never commit the real value to this file.
# AGENTCORE_SANDBOX_API_KEY=<deployment-secret>
# Used only when the direct Key above is absent. This is the default credential resource name.
# AGENTCORE_SANDBOX_CREDENTIAL=AGENT_SANDBOX_API_KEY
# AGENTCORE_SANDBOX_API_URL=https://<region-agent-sandbox-api-origin>
# AGENTCORE_SANDBOX_DOMAIN=<region-agent-sandbox-domain>
# AGENTCORE_SANDBOX_TEMPLATE=<prepared-template-name-or-id>
# AGENTCORE_SANDBOX_ROOT=/workspace
# AGENTCORE_SANDBOX_VOLUME_NAME=agent-sandbox-nas
# AGENTCORE_SANDBOX_VOLUME_MOUNT_PATH=/mnt/sandbox
# AGENTCORE_SANDBOX_TEAM_ID=<team-id> # required for Team-scoped RAM grants; also disambiguates duplicate names
# AGENTCORE_SANDBOX_TIMEOUT_MS=21600000
# AGENTCORE_SANDBOX_COMMAND_TIMEOUT_MS=3600000
# Sandbox acquisition is lazy: pure chat does not call the Sandbox API.
# Acquisition failures and timeouts never fall back to local execution.
# AGENTCORE_SANDBOX_REQUEST_TIMEOUT_MS=60000
# AGENTCORE_SANDBOX_ALLOW_INTERNET=false

# HTTP service; container default HOST is 0.0.0.0
HOST=127.0.0.1
PORT=8080
# AGENTCORE_RUNLOOP_API_TOKEN=<supply-securely>

# /v1/sts uses the AgentCore public gateway authentication by default.
# Optionally enable an additional HMAC layer by setting BOTH values below.
# Generate the shared secret with: openssl rand -hex 32
# AGENTCORE_STS_BROKER_KEY_ID=chat-server
# AGENTCORE_STS_BROKER_SECRET=<64-character-hex-secret>
# AGENTCORE_STS_DURATION_SECONDS=900

# Logging
# AGENTCORE_LOG_LEVEL=info
# AGENTCORE_LOG_DIR=./logs
# AGENTCORE_LOG_SINKS=stdout,file

# AgentLoop Agent insight. Keep the LicenseKey in the deployment secret store.
# AGENTCORE_AGENTLOOP_ENABLED=true
# AGENTCORE_AGENTLOOP_ENDPOINT=<agentloop-otlp-domain-or-traces-url>
# AGENTCORE_AGENTLOOP_LICENSE_KEY=<supply-securely>
# AGENTCORE_AGENTLOOP_PROJECT=<trace-project>
# AGENTCORE_AGENTLOOP_WORKSPACE=<cms-workspace>
# AGENTCORE_AGENTLOOP_SERVICE_NAME=agentcore-codex
# AGENTCORE_AGENTLOOP_SERVICE_VERSION=v0.1.0
# AGENTCORE_AGENTLOOP_ENVIRONMENT=production
# AGENTCORE_AGENTLOOP_CAPTURE_CONTENT=false
# AGENTCORE_AGENTLOOP_MAX_CONTENT_LENGTH=8192
# AGENTCORE_AGENTLOOP_EXPORT_TIMEOUT_MS=3000
# AGENTCORE_AGENTLOOP_FLUSH_TIMEOUT_MS=2000

# Local fixture mode only
# AGENTCORE_MOCK=true
# SMOKE_BASE_URL=http://127.0.0.1:8080

# Optional client benchmark configuration (scripts/benchmark-agui.mjs only).
# Set AGENTCORE_BENCHMARK_URL to your HTTPS AG-UI endpoint in your shell.
# Enter AGENTCORE_BENCHMARK_API_KEY interactively; never store a real key here.
# AGENTCORE_BENCHMARK_REQUESTS=10
# AGENTCORE_BENCHMARK_PAIRS=0
