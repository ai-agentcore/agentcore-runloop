{
  "name": "runloop",
  "version": "0.1.0",
  "description": "Agent loop runtime — drives agent CLIs via ACP with unified event protocol",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:stop": "bash scripts/dev-stop.sh",
    "dev:log": "tail -f logs/server.log",
    "dev:fg": "tsx src/server/index.ts",
    "build": "vite build",
    "test": "vitest run --pool=forks --maxWorkers=1",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cli": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alicloud/agentrun20250910": "^5.9.1",
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "hono": "^4.7.0",
    "nanoid": "^5.1.0",
    "pino": "^10.3.1",
    "tsx": "^4.19.0",
    "ws": "^8.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.23.3",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.1.0",
    "ali-oss": "^6.23.0",
    "json-schema-to-zod": "^2.8.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
